{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assessment_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "campaign_version": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "eligible",
        "excluded",
        "needs_information"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "batch": {
      "type": [
        "string",
        "null"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "field",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "mock",
        "ai",
        "manual"
      ]
    }
  },
  "required": [
    "schema_version",
    "assessment_id",
    "case_id",
    "campaign_id",
    "campaign_version",
    "decision",
    "model",
    "batch",
    "missing_fields",
    "clarification",
    "evidence",
    "reason",
    "mode"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assessment-response"
}
